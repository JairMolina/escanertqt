+uint8_t ComandoExacto(const char *comando, const char *esperado)
+{
+    size_t n = strlen(esperado);
+    if (strncmp(comando, esperado, n) != 0) { return 0; }
+    const char *fin = comando + n;
+    if (*fin == '\r') { ++fin; }
+    if (*fin == '\n') { ++fin; }
+    return *fin == '\0';
+}
+
 uint8_t FinComandoValido(char c)
 {
     return (c == '\r' || c == '\n' || c == '\0');
