# Copia a .env (lo hace desplegar.ps1 automáticamente)
TQT_HOST_IP=192.168.1.50
TZ=America/Mexico_City
# Contraseña inicial de las cuentas (obligatoria para crear las cuentas la primera vez; sin valor por defecto en el código)
TQT_USER_SEED_PASSWORD=
# Correo saliente (SMTP desde el backend; 465 = TLS implícito). La contraseña SOLO aquí en .env, nunca en Git.
TQT_SMTP_HOST=smtp.hostinger.com
TQT_SMTP_PORT=465
TQT_SMTP_USER=inventario@inventariotqt.site
TQT_SMTP_PASSWORD=
TQT_SMTP_FROM=inventario@inventariotqt.site
TQT_SMTP_FROM_NAME=Inventario TQT
